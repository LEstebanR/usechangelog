    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
