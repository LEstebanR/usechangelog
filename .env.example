# Every variable the code reads. Copy this file to .env.local and fill it in; real .env* files
# are git-ignored. Where each value comes from is in README → Environment variables.

# Neon Postgres. Production: the `production` branch. Preview and local: the `develop` branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Managed Better Auth on the same Neon branch. The cookie secret is random, at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon API, to delete a user's account (#31): an API key, the project id, and the id (br-…) of the
# same branch as above (`develop` for Preview and local, `production` for Production).
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Polar (billing). Production uses the production organization and POLAR_SERVER=production;
# Preview and local use the sandbox organization and POLAR_SERVER=sandbox.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=
POLAR_WEBHOOK_SECRET=
# Optional, Production only and temporary: "true" shows the discount code field in the checkout
# while Polar reviews the account (their team uses a 100% code). Delete it once approved.
POLAR_ALLOW_DISCOUNT_CODES=

# Canonical site URL for metadata (#13). Production only: https://www.usechangelog.com.
# Unset on previews (they use VERCEL_URL) and locally (localhost).
NEXT_PUBLIC_SITE_URL=

# Optional, local only: lets `bun run widget-test` and `bun run smoke` reach a protected
# Vercel preview. Vercel → Settings → Deployment Protection → Protection Bypass for
# Automation. Never in Vercel's env vars or in a snippet.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional, for `bun run smoke`: a magic link to use instead of requesting one, and "1" to
# allow running it against production.
SMOKE_LINK=
SMOKE_ALLOW_PRODUCTION=

# Set by Vercel on every deployment; never set them yourself.
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
