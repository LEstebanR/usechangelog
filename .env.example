# Neon Postgres. Set by the Neon integration in Vercel (Production and Preview).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Managed Better Auth. The base URL comes from the Neon integration;
# the cookie secret is set by hand (random, at least 32 characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional, local only: lets `bun run widget-test` load the widget from a protected
# Vercel preview. Vercel → Settings → Deployment Protection → Protection Bypass for
# Automation. Never in Vercel's env vars or in a snippet.
VERCEL_AUTOMATION_BYPASS_SECRET=
